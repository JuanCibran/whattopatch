# Copy to .env.local for local development. On Vercel, set these in
# Project Settings > Environment Variables. Never commit real values.

# Public URL of your deployment (used in links, RSS and the User-Agent sent to sources).
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
# Optional: link to the source repository, shown in the header.
NEXT_PUBLIC_REPO_URL=

# Required for the daily digest. Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Optional channels for the daily digest. Configure any of them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
